# ─────────────────────────────────────────────────────────────
# TradingView MCP Server – Configuración de entorno
# Copia este archivo como .env y ajusta los valores
# ─────────────────────────────────────────────────────────────

# Secreto compartido entre TradingView y tu servidor
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
TV_WEBHOOK_SECRET=changeme_secret_2024
# Con el valor por defecto el webhook rechaza todo (falla en cerrado).
# Solo para pruebas locales: TV_ALLOW_INSECURE=1
TV_ALLOW_INSECURE=0

# Ruta a la base de datos SQLite
TV_DB_PATH=./data/alerts/alerts.db

# Host y puerto del servidor webhook
TV_HOST=0.0.0.0
TV_PORT=8000

# Puerto del servidor MCP (si se usa SSE remoto)
MCP_PORT=8001

# Modo de exposición pública (opcional: ngrok, cloudflare tunnel, VPS)
# Deja vacío si usas el servidor directamente
PUBLIC_URL=
